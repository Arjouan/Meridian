# =============================================================
# Copy this file to .env and fill in real values.
# .env is git-ignored and must NEVER be committed.
# =============================================================

# ---- App ----
NODE_ENV=development

# ---- API (NestJS) ----
API_PORT=3001

# ---- Web (Next.js) ----
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# ---- PostgreSQL (with PostGIS / TimescaleDB) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me
POSTGRES_DB=maritime
# Prisma uses this single connection string:
DATABASE_URL=postgresql://app:change_me@localhost:5432/maritime?schema=public

# ---- Redis (jobs, cache, realtime) ----
REDIS_URL=redis://localhost:6379

# ---- Auth ----
# Generate a long random string, e.g.: openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ---- Map tiles (MapLibre; optional until the map is built) ----
NEXT_PUBLIC_MAP_STYLE_URL=
MAP_TILES_API_KEY=

# ---- AIS / vessel position feed (optional, later phases) ----
AIS_MQTT_URL=
AIS_API_KEY=
